{
  "name": "venticorn-extension",
  "displayName": "Venticorn",
  "_venticornNotice": "Modified for Venticorn: product naming, repository metadata, and supported VS Code version.",
  "version": "0.1.0",
  "description": "The Venticorn theorem prover for VS Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnclyde/venticorn.git",
    "directory": "vscode/extension"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "build/extension/bundle.js",
  "contributes": {
    "languages": [
      {
        "id": "acorn",
        "extensions": [
          ".ac"
        ],
        "aliases": [
          "Venticorn",
          "Acorn",
          "acorn"
        ],
        "configuration": "language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "acorn",
        "scopeName": "source.acorn",
        "path": "syntaxes/acorn.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "category": "Venticorn",
        "command": "acorn.newFile",
        "title": "New Venticorn File"
      },
      {
        "category": "Venticorn",
        "command": "acorn.displayInfoView",
        "title": "Info View: Display",
        "description": "Show the info view.",
        "icon": {
          "light": "images/venticorn-assistant-color.png",
          "dark": "images/venticorn-assistant-color.png"
        }
      },
      {
        "category": "Venticorn",
        "command": "acorn.toggleInfoView",
        "title": "Info View: Toggle",
        "description": "Toggle whether the info view is displayed."
      }
    ],
    "keybindings": [
      {
        "command": "acorn.toggleInfoView",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == acorn"
      },
      {
        "command": "acorn.toggleInfoView",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == acorn"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "acorn.displayInfoView",
          "group": "navigation",
          "when": "editorLangId == acorn"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc -p ./ --noEmit",
    "build": "npm run check && node build.mjs",
    "test": "tsc -p ./ && node --test ../../tests/editor_lifecycle_test.cjs ../../tests/server_path_test.cjs ../../tests/server_download_test.cjs ../../tests/info_view_test.cjs"
  },
  "author": "Kevin Lacker",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.6.3",
    "@types/vscode": "^1.82.0",
    "esbuild": "0.24.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "icon": "images/venticorn-assistant-128.png",
  "files": [
    "build/extension/**",
    "build/info/**",
    "language-configuration.json",
    "syntaxes/**",
    "images/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "acornlib/*.ac",
    "acornlib/LICENSE",
    "acornlib/NOTICE"
  ],
  "publisher": "johnclyde"
}
