// Modified for Venticorn: locked local builds and portable asset staging.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "extension: npm compile",
      "type": "npm",
      "script": "compile",
      "options": {
        "cwd": "${workspaceFolder}/vscode/extension"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "extension: npm watch",
      "type": "npm",
      "script": "watch",
      "options": {
        "cwd": "${workspaceFolder}/vscode/extension"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": [
        "$tsc-watch"
      ]
    },
    {
      "label": "search: npm build",
      "type": "npm",
      "script": "build",
      "options": {
        "cwd": "${workspaceFolder}/vscode/search"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "language server: cargo build",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--locked",
        "--release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "language server: copy executable",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/copy-language-server.cjs"
      ],
      "dependsOn": "language server: cargo build",
      "problemMatcher": []
    },
    {
      "label": "build all",
      "dependsOn": [
        "extension: npm compile",
        "search: npm build",
        "language server: copy executable"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
